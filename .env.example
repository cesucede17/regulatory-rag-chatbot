# ─── Anthropic / Claude ────────────────────────────────────────────
# Obtén tu clave en: https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
CLAUDE_MODEL=claude-sonnet-5
TEMPERATURE=0.1

# ─── Embeddings (locales, sin coste de API) ────────────────────────
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ─── API del BOE ───────────────────────────────────────────────────
BOE_SUMARIO_API_URL=https://www.boe.es/datosabiertos/api/boe/sumario/
BOE_LEGISLACION_API_URL=https://www.boe.es/datosabiertos/api/legislacion-consolidada

# ─── Procesado de documentos ───────────────────────────────────────
DOCUMENTS_FOLDER=./data/documents
VECTOR_DB_PATH=./vectordb
CHUNK_SIZE=1800
CHUNK_OVERLAP=360
TOP_K_RESULTS=10
SIMILARITY_THRESHOLD=1.2

# ─── RAG / contexto del LLM ────────────────────────────────────────
EMBEDDING_CACHE_TTL=300
CONTEXT_MAX_TOKENS=1200
HISTORY_MAX_MESSAGES=8

# ─── LangSmith (opcional): tracing apagado salvo LANGSMITH_TRACING=true
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tambora-chatbot

# ─── Auth / multiusuario ───────────────────────────────────────────
# Esta herramienta tiene su propia tabla de usuarios: los usuarios que crees
# aquí NO existen en Tambora_auditorias, y al contrario.
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_ENV_VAR
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8
COOKIE_SECURE=false

# ─── Base de datos y retención ─────────────────────────────────────
CHATBOT_DB_PATH=data/chatbot.db
DAILY_QUERY_LIMIT=50
CONCURRENT_QUERY_LIMIT=2
CHAT_RETENTION_DAYS=15

# ─── Panel de coste ────────────────────────────────────────────────
USD_EUR_RATE=0.92

# --- SSO contra Keycloak (2026-09-15) ------------------------------------
# La UNICA forma de entrar en Tambora. El login propio se retiro: ya no hay
# usuario y contrasena, ni contrasenas compartidas.
#
# Sin las cuatro primeras la aplicacion NO ARRANCA, a proposito: al no haber
# login propio, una configuracion a medias dejaria la herramienta
# inaccesible sin decir por que.
#
# Las URLs llevan el dominio de la plataforma; en el servidor las deriva el
# compose de SGE_BASE_DOMAIN (ver platform/.env.example).
TAMBORA_SSO_ISSUER=http://auth.sge.local:8080/realms/sge
TAMBORA_SSO_CLIENT_ID=tambora
# Se obtiene de Keycloak (ver platform/identity/README.md). NUNCA se commitea.
TAMBORA_SSO_CLIENT_SECRET=
TAMBORA_SSO_REDIRECT_URI=http://tambora.sge.local:8080/sso/callback
# A donde vuelve Keycloak tras cerrar sesion. Tiene que estar dado de alta
# como atributo post.logout.redirect.uris en el cliente.
TAMBORA_SSO_POST_LOGOUT_URI=http://sge.local:8080/

# SGE_BASE_DOMAIN_ALT: el dominio ANTERIOR durante un cambio de dominio, para
# que la herramienta responda por los dos nombres a la vez. Se documenta
# entero en platform/.env.example. Aqui vale la misma regla que SGE_BASE_DOMAIN:
# el mismo valor en todos los .env, o cada pieza enruta por un sitio.
# SGE_BASE_DOMAIN_ALT=

# TAMBORA_RUTA_BASE: bajo que ruta se sirve la herramienta. Vacia (por defecto),
# emite sus enlaces desde la raiz y solo funciona el camino por nombre
# (tambora.<dominio>); puesta a /tambora, solo funciona el camino por ruta
# (<dominio>/tambora). Va a la par con SGE_RUTAS de platform/.env. Lo explica el
# bloque de etiquetas de Traefik en docker-compose.yml.
# TAMBORA_RUTA_BASE=

# La vuelta al recibidor. En la plataforma la deriva docker-compose.yml de
# SGE_BASE_DOMAIN; vacia = no se pinta el enlace.
# TAMBORA_PLATAFORMA_URL=http://sge.local:8080/
